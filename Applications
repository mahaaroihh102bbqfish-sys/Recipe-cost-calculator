```html
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recipe Cost Calculator Pro - เครื่องคำนวณต้นทุนร้านอาหาร</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Prompt', sans-serif; }
    input[type=number]::-webkit-inner-spin-button, 
    input[type=number]::-webkit-outer-spin-button { 
      -webkit-appearance: none; 
      margin: 0; 
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen">
  <div id="app" class="pb-16">
    <!-- Top Navigation Bar -->
    <header class="bg-slate-900 text-white sticky top-0 z-30 shadow-md">
      <div class="max-w-7xl mx-auto px-4 py-3 sm:px-6 flex flex-wrap justify-between items-center gap-3">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500 flex items-center justify-center font-black text-xl text-slate-950 shadow-inner">
            ฿
          </div>
          <div>
            <h1 class="text-lg sm:text-xl font-bold tracking-tight">RECIPE COST CALCULATOR <span class="text-amber-400">PRO</span></h1>
            <p class="text-xs text-slate-400">ระบบจัดการต้นทุนสูตรอาหารและวิเคราะห์กำไรสำหรับร้านอาหาร</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button @click="exportToExcel" class="flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-sm font-medium transition shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            <span>ส่งออก Excel</span>
          </button>
          <button @click="resetToDefaultData" class="text-xs text-slate-400 hover:text-rose-400 underline px-2 py-1">
            โหลดข้อมูลตัวอย่าง
          </button>
        </div>
      </div>

      <!-- Tab Buttons -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 flex gap-2 border-t border-slate-800 pt-2 pb-1 overflow-x-auto">
        <button 
          @click="activeTab = 'ingredients'"
          :class="activeTab === 'ingredients' ? 'bg-amber-500 text-slate-950 font-bold' : 'text-slate-300 hover:bg-slate-800'"
          class="px-4 py-2 rounded-lg text-sm transition flex items-center gap-2 whitespace-nowrap">
          <span>📦 1. ฐานข้อมูลวัตถุดิบ & Yield</span>
          <span class="bg-slate-900/40 text-xs px-2 py-0.5 rounded-full">{{ ingredients.length }}</span>
        </button>

        <button 
          @click="activeTab = 'recipes'"
          :class="activeTab === 'recipes' ? 'bg-amber-500 text-slate-950 font-bold' : 'text-slate-300 hover:bg-slate-800'"
          class="px-4 py-2 rounded-lg text-sm transition flex items-center gap-2 whitespace-nowrap">
          <span>🍳 2. คำนวณต้นทุนสูตรอาหาร (Recipes)</span>
          <span class="bg-slate-900/40 text-xs px-2 py-0.5 rounded-full">{{ recipes.length }}</span>
        </button>

        <button 
          @click="activeTab = 'dashboard'"
          :class="activeTab === 'dashboard' ? 'bg-amber-500 text-slate-950 font-bold' : 'text-slate-300 hover:bg-slate-800'"
          class="px-4 py-2 rounded-lg text-sm transition flex items-center gap-2 whitespace-nowrap">
          <span>📊 3. วิเคราะห์กำไร & Menu Engineering</span>
        </button>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 mt-6">
      
      <!-- TAB 1: INGREDIENTS MASTER -->
      <div v-if="activeTab === 'ingredients'" class="space-y-4">
        <!-- Top alert / info -->
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 flex items-start gap-3 text-amber-900">
          <div class="text-2xl">💡</div>
          <div class="text-xs sm:text-sm leading-relaxed">
            <strong>หัวใจสำคัญของ Pro Version (Yield %):</strong> วัตถุดิบสดเมื่อซื้อมา (AP) เมื่อนำมาตัดแต่ง ปอกเปลือก หรือต้มสุก จะมีน้ำหนักสูญเสียไป ต้นทุนที่แท้จริงคือ <strong>EP Cost (Edible Portion)</strong> ซึ่งคำนวณจาก <code>ราคาซื้อ ÷ (ปริมาณ × Yield %)</code> ทำให้คุณไม่ตั้งราคาขายขาดทุนโดยไม่รู้ตัว
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="p-4 bg-slate-50 border-b border-slate-200 flex flex-wrap justify-between items-center gap-3">
            <div class="flex items-center gap-2">
              <h2 class="font-bold text-slate-800 text-base sm:text-lg">รายการวัตถุดิบทั้งหมด (Raw Materials)</h2>
              <span class="text-xs text-slate-500">(แก้ไขค่าในช่องได้ทันที ข้อมูลจะบันทึกอัตโนมัติ)</span>
            </div>
            <button @click="addIngredient" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-sm font-semibold flex items-center gap-2 shadow-sm transition">
              <span>+ เพิ่มวัตถุดิบ</span>
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
              <thead class="bg-slate-100/75 text-slate-600 font-semibold border-b border-slate-200 text-xs uppercase tracking-wider">
                <tr>
                  <th class="p-3.5">ชื่อวัตถุดิบ</th>
                  <th class="p-3.5">หมวดหมู่</th>
                  <th class="p-3.5 text-right">ราคาซื้อ (บาท)</th>
                  <th class="p-3.5 text-right">ปริมาณซื้อ</th>
                  <th class="p-3.5 text-center">หน่วยนับ</th>
                  <th class="p-3.5 text-right text-amber-700">Yield % (ส่วนที่ใช้ได้)</th>
                  <th class="p-3.5 text-right text-emerald-700">ต้นทุนแท้จริง (EP Cost)</th>
                  <th class="p-3.5 text-center">จัดการ</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                <tr v-for="(ing, idx) in ingredients" :key="ing.id" class="hover:bg-amber-50/40 transition">
                  <td class="p-3 min-w-[160px]">
                    <input v-model="ing.name" @input="saveData" class="w-full font-medium bg-transparent border-b border-transparent focus:border-amber-500 focus:bg-white px-1 py-0.5 rounded outline-none" placeholder="เช่น เนื้ออกไก่สด" />
                  </td>
                  <td class="p-3 min-w-[120px]">
                    <select v-model="ing.category" @change="saveData" class="w-full bg-slate-100 rounded px-2 py-1 text-xs border border-slate-200 focus:outline-none focus:border-amber-500">
                      <option value="เนื้อสัตว์">🥩 เนื้อสัตว์</option>
                      <option value="ผักผลไม้">🥦 ผักผลไม้</option>
                      <option value="เครื่องปรุง">🧂 เครื่องปรุง</option>
                      <option value="ของแห้ง/แป้ง">🌾 ของแห้ง/แป้ง</option>
                      <option value="บรรจุภัณฑ์">📦 บรรจุภัณฑ์</option>
                      <option value="อื่นๆ">기 อื่นๆ</option>
                    </select>
                  </td>
                  <td class="p-3 text-right">
                    <input type="number" step="any" v-model.number="ing.purchasePrice" @input="saveData" class="w-24 text-right bg-slate-50 border border-slate-200 rounded px-2 py-1 font-semibold focus:bg-white focus:border-amber-500 outline-none" />
                  </td>
                  <td class="p-3 text-right">
                    <input type="number" step="any" v-model.number="ing.purchaseQty" @input="saveData" class="w-20 text-right bg-slate-50 border border-slate-200 rounded px-2 py-1 focus:bg-white focus:border-amber-500 outline-none" />
                  </td>
                  <td class="p-3 text-center">
                    <select v-model="ing.unit" @change="saveData" class="bg-slate-50 border border-slate-200 rounded px-2 py-1 text-xs focus:bg-white focus:border-amber-500 outline-none">
                      <option value="kg">kg (กิโลกรัม)</option>
                      <option value="g">g (กรัม)</option>
                      <option value="L">L (ลิตร)</option>
                      <option value="ml">ml (มิลลิลิตร)</option>
                      <option value="ฟอง">ฟอง</option>
                      <option value="ชิ้น">ชิ้น</option>
                      <option value="แพ็ค">แพ็ค</option>
                    </select>
                  </td>
                  <td class="p-3 text-right">
                    <div class="flex items-center justify-end gap-1">
                      <input type="number" min="1" max="100" v-model.number="ing.yieldPercent" @input="saveData" class="w-16 text-right bg-amber-50 border border-amber-300 font-bold text-amber-900 rounded px-2 py-1 focus:bg-white focus:border-amber-500 outline-none" />
                      <span class="text-xs text-amber-700 font-semibold">%</span>
                    </div>
                  </td>
                  <td class="p-3 text-right font-bold text-emerald-700 whitespace-nowrap">
                    ฿{{ getEpUnitCost(ing).toFixed(2) }} <span class="text-xs font-normal text-slate-500">/ {{ ing.unit }}</span>
                  </td>
                  <td class="p-3 text-center">
                    <button @click="deleteIngredient(idx)" class="text-slate-400 hover:text-rose-600 transition p-1" title="ลบวัตถุดิบ">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB 2: RECIPES & COSTING -->
      <div v-if="activeTab === 'recipes'" class="space-y-6">
        <div class="flex justify-between items-center">
          <div>
            <h2 class="text-xl font-bold text-slate-800">สูตรมาตรฐานและโครงสร้างต้นทุนจาน (Recipe Cards)</h2>
            <p class="text-xs sm:text-sm text-slate-500">ผูกวัตถุดิบจากคลัง ระบบจะคำนวณต้นทุนต่อจานและตั้งราคาขายแนะนำให้อัตโนมัติ</p>
          </div>
          <button @click="addRecipe" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold rounded-xl text-sm shadow-sm transition flex items-center gap-1.5">
            <span>+ สร้างสูตรเมนูใหม่</span>
          </button>
        </div>

        <div v-for="(recipe, rIdx) in recipes" :key="recipe.id" class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <!-- Recipe Header Bar -->
          <div class="p-4 sm:p-5 bg-gradient-to-r from-slate-900 to-slate-800 text-white flex flex-wrap justify-between items-center gap-4">
            <div class="flex-1 min-w-[200px]">
              <input v-model="recipe.name" @input="saveData" class="text-lg sm:text-xl font-bold bg-transparent border-b border-transparent focus:border-amber-400 outline-none w-full text-amber-300" placeholder="ระบุชื่อเมนูอาหาร" />
              <div class="text-xs text-slate-400 mt-1 flex gap-4">
                <span>จำนวนเสิร์ฟต่อสูตร: 
                  <input type="number" min="1" v-model.number="recipe.portion" @input="saveData" class="w-12 bg-slate-700 text-white rounded px-1 text-center font-bold" /> ที่
                </span>
                <span>ส่วนผสม: {{ recipe.items.length }} รายการ</span>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="text-right">
                <div class="text-xs text-slate-400">ต้นทุนต่อจาน (Food Cost)</div>
                <div class="text-xl font-black text-white">฿{{ getRecipePortionCost(recipe).toFixed(2) }}</div>
              </div>
              <button @click="deleteRecipe(rIdx)" class="text-slate-400 hover:text-rose-400 p-2" title="ลบสูตรนี้">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </div>
          </div>

          <!-- Recipe Body -->
          <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-slate-200">
            <!-- Left: Ingredients in Recipe -->
            <div class="lg:col-span-8 p-4 sm:p-5">
              <div class="flex justify-between items-center mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500">ส่วนผสมและปริมาณที่ใช้</span>
                <button @click="addRecipeItem(recipe)" class="text-xs font-semibold text-amber-700 hover:text-amber-800 flex items-center gap-1">
                  <span>+ เพิ่มวัตถุดิบในสูตร</span>
                </button>
              </div>

              <div class="space-y-2">
                <div v-for="(item, iIdx) in recipe.items" :key="iIdx" class="flex flex-wrap sm:flex-nowrap items-center gap-2 p-2 rounded-lg bg-slate-50 border border-slate-200">
                  <select v-model="item.ingredientId" @change="saveData" class="flex-1 bg-white border border-slate-200 rounded px-2 py-1.5 text-xs sm:text-sm focus:outline-none focus:border-amber-500">
                    <option value="" disabled>-- เลือกวัตถุดิบ --</option>
                    <option v-for="ing in ingredients" :key="ing.id" :value="ing.id">
                      {{ ing.name }} (฿{{ getEpUnitCost(ing).toFixed(2) }}/{{ ing.unit }})
                    </option>
                  </select>

                  <div class="flex items-center gap-1">
                    <input type="number" step="any" min="0" v-model.number="item.qty" @input="saveData" class="w-20 text-right bg-white border border-slate-200 rounded px-2 py-1.5 text-xs sm:text-sm font-semibold focus:outline-none focus:border-amber-500" placeholder="ปริมาณ" />
                    <span class="text-xs text-slate-500 w-10 text-center">{{ getItemUnit(item.ingredientId) }}</span>
                  </div>

                  <div class="w-24 text-right font-bold text-slate-700 text-xs sm:text-sm">
                    ฿{{ getItemCost(item).toFixed(2) }}
                  </div>

                  <button @click="removeRecipeItem(recipe, iIdx)" class="text-slate-400 hover:text-rose-500 p-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                  </button>
                </div>

                <div v-if="recipe.items.length === 0" class="text-center py-6 text-slate-400 text-xs sm:text-sm border-2 border-dashed border-slate-200 rounded-xl">
                  ยังไม่มีวัตถุดิบในสูตรนี้ กดปุ่ม "+ เพิ่มวัตถุดิบในสูตร" ด้านบนเพื่อเริ่มคำนวณ
                </div>
              </div>
            </div>

            <!-- Right: Pricing & Margin Calculator -->
            <div class="lg:col-span-4 p-4 sm:p-5 bg-slate-50/60 space-y-4">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">การตั้งราคาและกำไรต่อจาน</span>

              <div class="space-y-3 text-sm">
                <div class="flex justify-between items-center">
                  <span class="text-slate-600">ต้นทุนต่อจาน:</span>
                  <span class="font-bold text-slate-900 text-base">฿{{ getRecipePortionCost(recipe).toFixed(2) }}</span>
                </div>

                <div>
                  <div class="flex justify-between text-xs text-slate-500 mb-1">
                    <span>เป้าหมาย Food Cost %:</span>
                    <span class="font-bold text-slate-700">{{ recipe.targetFoodCost }}%</span>
                  </div>
                  <input type="range" min="15" max="50" v-model.number="recipe.targetFoodCost" @input="saveData" class="w-full accent-amber-500" />
                  <div class="text-[11px] text-slate-400 flex justify-between">
                    <span>15% (Fine Dining)</span>
                    <span>30-35% (Casual)</span>
                    <span>50%</span>
                  </div>
                </div>

                <div class="p-3 bg-amber-100/70 border border-amber-300 rounded-xl">
                  <div class="text-xs text-amber-900 font-semibold">ราคาขายที่แนะนำ (ตามเป้าหมาย %):</div>
                  <div class="text-2xl font-black text-amber-950">฿{{ getRecommendedPrice(recipe).toFixed(0) }}</div>
                  <div class="text-[10px] text-amber-700 mt-0.5">* คำนวณจาก ต้นทุน ÷ เป้าหมาย Food Cost</div>
                </div>

                <div>
                  <label class="text-xs font-bold text-slate-700 uppercase block mb-1">ราคาขายจริงที่คุณตั้งหน้าร้าน (บาท):</label>
                  <input type="number" step="any" v-model.number="recipe.sellingPrice" @input="saveData" class="w-full bg-white border-2 border-slate-300 focus:border-slate-900 rounded-xl px-3 py-2 text-lg font-black text-slate-900 outline-none shadow-sm" />
                </div>

                <!-- Margin & Actual % -->
                <div class="pt-2 border-t border-slate-200 space-y-2">
                  <div class="flex justify-between items-center">
                    <span class="text-slate-600">Food Cost จริง:</span>
                    <span :class="getActualFoodCostPercent(recipe) > recipe.targetFoodCost ? 'text-rose-600' : 'text-emerald-700'" class="font-bold text-base">
                      {{ getActualFoodCostPercent(recipe).toFixed(1) }}%
                    </span>
                  </div>

                  <div class="flex justify-between items-center">
                    <span class="text-slate-600">กำไรส่วนเกินต่อจาน (Margin):</span>
                    <span class="font-bold text-emerald-700 text-base">
                      ฿{{ getProfitPerPortion(recipe).toFixed(2) }}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: DASHBOARD & MENU ENGINEERING -->
      <div v-if="activeTab === 'dashboard'" class="space-y-6">
        <!-- Overview Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
            <div class="text-xs font-semibold text-slate-400 uppercase">จำนวนเมนูทั้งหมด</div>
            <div class="text-3xl font-black text-slate-900 mt-1">{{ recipes.length }} เมนู</div>
          </div>
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
            <div class="text-xs font-semibold text-slate-400 uppercase">ค่าเฉลี่ย Food Cost รวม</div>
            <div class="text-3xl font-black text-amber-600 mt-1">{{ getAverageFoodCost().toFixed(1) }}%</div>
          </div>
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
            <div class="text-xs font-semibold text-slate-400 uppercase">กำไรต่อจานเฉลี่ย (Contribution Margin)</div>
            <div class="text-3xl font-black text-emerald-600 mt-1">฿{{ getAverageMargin().toFixed(2) }}</div>
          </div>
        </div>

        <!-- Matrix Summary Table -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="p-4 bg-slate-50 border-b border-slate-200">
            <h3 class="font-bold text-slate-800">ตารางเปรียบเทียบกำไรของทุกเมนู (Profitability Matrix)</h3>
            <p class="text-xs text-slate-500">ช่วยให้ผู้บริหารร้านอาหารรู้ว่าเมนูใดสร้างเงินสด (Cash Flow) ให้ร้านได้มากที่สุด</p>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-100 text-slate-600 text-xs font-semibold uppercase">
                <tr>
                  <th class="p-3.5">ชื่อเมนู</th>
                  <th class="p-3.5 text-right">ต้นทุน/จาน</th>
                  <th class="p-3.5 text-right">ราคาขายหน้าร้าน</th>
                  <th class="p-3.5 text-right">Food Cost %</th>
                  <th class="p-3.5 text-right text-emerald-700">กำไร/จาน (Margin)</th>
                  <th class="p-3.5 text-center">สถานะสุขภาพเมนู</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                <tr v-for="recipe in recipes" :key="recipe.id" class="hover:bg-slate-50">
                  <td class="p-3.5 font-bold text-slate-800">{{ recipe.name }}</td>
                  <td class="p-3.5 text-right">฿{{ getRecipePortionCost(recipe).toFixed(2) }}</td>
                  <td class="p-3.5 text-right font-semibold">฿{{ recipe.sellingPrice.toFixed(2) }}</td>
                  <td class="p-3.5 text-right font-bold" :class="getActualFoodCostPercent(recipe) > 35 ? 'text-rose-600' : 'text-slate-700'">
                    {{ getActualFoodCostPercent(recipe).toFixed(1) }}%
                  </td>
                  <td class="p-3.5 text-right font-black text-emerald-600">
                    ฿{{ getProfitPerPortion(recipe).toFixed(2) }}
                  </td>
                  <td class="p-3.5 text-center">
                    <span v-if="getProfitPerPortion(recipe) > 100 && getActualFoodCostPercent(recipe) <= 32" class="px-2 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                      ⭐ เมนูดาวเด่น (Star)
                    </span>
                    <span v-else-if="getActualFoodCostPercent(recipe) > 38" class="px-2 py-1 rounded-full text-xs font-semibold bg-rose-100 text-rose-800">
                      ⚠️ ต้นทุนสูงเกินเกณฑ์
                    </span>
                    <span v-else class="px-2 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">
                      ✔️ มาตรฐาน (Good)
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </main>
  </div>

  <script>
    const { createApp, ref, computed, onMounted } = Vue;

    createApp({
      setup() {
        const activeTab = ref('ingredients');
        const ingredients = ref([]);
        const recipes = ref([]);

        // Default Data Set
        const sampleIngredients = [
          { id: '1', name: 'อกไก่สด', category: 'เนื้อสัตว์', purchasePrice: 95, purchaseQty: 1, unit: 'kg', yieldPercent: 88 },
          { id: '2', name: 'เนื้อสันคอหมู', category: 'เนื้อสัตว์', purchasePrice: 175, purchaseQty: 1, unit: 'kg', yieldPercent: 92 },
          { id: '3', name: 'ผักกาดแก้ว', category: 'ผักผลไม้', purchasePrice: 65, purchaseQty: 1, unit: 'kg', yieldPercent: 75 },
          { id: '4', name: 'ไข่ไก่เบอร์ 2', category: 'เครื่องปรุง', purchasePrice: 130, purchaseQty: 30, unit: 'ฟอง', yieldPercent: 100 },
          { id: '5', name: 'ซอสปรุงรสฝาเขียว', category: 'เครื่องปรุง', purchasePrice: 48, purchaseQty: 1, unit: 'L', yieldPercent: 100 },
          { id: '6', name: 'ข้าวหอมมะลิ', category: 'ของแห้ง/แป้ง', purchasePrice: 195, purchaseQty: 5, unit: 'kg', yieldPercent: 100 },
          { id: '7', name: 'กล่องอาหารรักษ์โลก', category: 'บรรจุภัณฑ์', purchasePrice: 150, purchaseQty: 50, unit: 'ชิ้น', yieldPercent: 100 }
        ];

        const sampleRecipes = [
          {
            id: 'r1',
            name: 'ข้าวกะเพราอกไก่ไข่ดาว',
            portion: 1,
            targetFoodCost: 30,
            sellingPrice: 75,
            items: [
              { ingredientId: '1', qty: 0.15 },  // 150g อกไก่
              { ingredientId: '6', qty: 0.12 },  // 120g ข้าวสาร
              { ingredientId: '4', qty: 1 },     // ไข่ 1 ฟอง
              { ingredientId: '5', qty: 0.02 },  // ซอส 20ml
              { ingredientId: '7', qty: 1 }      // กล่อง 1 ชิ้น
            ]
          },
          {
            id: 'r2',
            name: 'สลัดสันคอหมูย่างน้ำตก',
            portion: 1,
            targetFoodCost: 32,
            sellingPrice: 149,
            items: [
              { ingredientId: '2', qty: 0.18 },
              { ingredientId: '3', qty: 0.10 },
              { ingredientId: '5', qty: 0.03 }
            ]
          }
        ];

        // Load & Save to LocalStorage
        const loadSavedData = () => {
          const savedIng = localStorage.getItem('bistodio_pro_ingredients');
          const savedRec = localStorage.getItem('bistodio_pro_recipes');
          if (savedIng && savedRec) {
            try {
              ingredients.value = JSON.parse(savedIng);
              recipes.value = JSON.parse(savedRec);
            } catch (e) {
              resetToDefaultData();
            }
          } else {
            resetToDefaultData();
          }
        };

        const saveData = () => {
          localStorage.setItem('bistodio_pro_ingredients', JSON.stringify(ingredients.value));
          localStorage.setItem('bistodio_pro_recipes', JSON.stringify(recipes.value));
        };

        const resetToDefaultData = () => {
          ingredients.value = JSON.parse(JSON.stringify(sampleIngredients));
          recipes.value = JSON.parse(JSON.stringify(sampleRecipes));
          saveData();
        };

        // Calculations
        const getEpUnitCost = (ing) => {
          if (!ing || !ing.purchasePrice || !ing.purchaseQty || !ing.yieldPercent) return 0;
          const apCost = ing.purchasePrice / ing.purchaseQty;
          return apCost / (ing.yieldPercent / 100);
        };

        const getItemUnit = (ingId) => {
          const ing = ingredients.value.find(i => i.id === ingId);
          return ing ? ing.unit : '-';
        };

        const getItemCost = (item) => {
          const ing = ingredients.value.find(i => i.id === item.ingredientId);
          if (!ing) return 0;
          return getEpUnitCost(ing) * (Number(item.qty) || 0);
        };

        const getRecipeTotalCost = (recipe) => {
          return recipe.items.reduce((sum, item) => sum + getItemCost(item), 0);
        };

        const getRecipePortionCost = (recipe) => {
          const portion = Number(recipe.portion) || 1;
          return getRecipeTotalCost(recipe) / portion;
        };

        const getRecommendedPrice = (recipe) => {
          const target = Number(recipe.targetFoodCost) || 30;
          const cost = getRecipePortionCost(recipe);
          return cost / (target / 100);
        };

        const getActualFoodCostPercent = (recipe) => {
          const price = Number(recipe.sellingPrice) || 0;
          if (price <= 0) return 0;
          return (getRecipePortionCost(recipe) / price) * 100;
        };

        const getProfitPerPortion = (recipe) => {
          const price = Number(recipe.sellingPrice) || 0;
          return price - getRecipePortionCost(recipe);
        };

        // Aggregates
        const getAverageFoodCost = () => {
          if (recipes.value.length === 0) return 0;
          const sum = recipes.value.reduce((acc, r) => acc + getActualFoodCostPercent(r), 0);
          return sum / recipes.value.length;
        };

        const getAverageMargin = () => {
          if (recipes.value.length === 0) return 0;
          const sum = recipes.value.reduce((acc, r) => acc + getProfitPerPortion(r), 0);
          return sum / recipes.value.length;
        };

        // Actions
        const addIngredient = () => {
          ingredients.value.push({
            id: Date.now().toString(),
            name: 'วัตถุดิบใหม่',
            category: 'เนื้อสัตว์',
            purchasePrice: 100,
            purchaseQty: 1,
            unit: 'kg',
            yieldPercent: 100
          });
          saveData();
        };

        const deleteIngredient = (index) => {
          ingredients.value.splice(index, 1);
          saveData();
        };

        const addRecipe = () => {
          recipes.value.push({
            id: Date.now().toString(),
            name: 'เมนูใหม่',
            portion: 1,
            targetFoodCost: 30,
            sellingPrice: 0,
            items: []
          });
          saveData();
        };

        const deleteRecipe = (index) => {
          recipes.value.splice(index, 1);
          saveData();
        };

        const addRecipeItem = (recipe) => {
          const firstIng = ingredients.value[0];
          recipe.items.push({
            ingredientId: firstIng ? firstIng.id : '',
            qty: 0.1
          });
          saveData();
        };

        const removeRecipeItem = (recipe, index) => {
          recipe.items.splice(index, 1);
          saveData();
        };

        // Export to CSV / Excel
        const exportToExcel = () => {
          let csv = "\uFEFF"; // UTF-8 BOM for Thai support in Excel
          csv += "--- รายการวัตถุดิบและ YIELD (INGREDIENTS) ---\n";
          csv += "ชื่อวัตถุดิบ,หมวดหมู่,ราคาซื้อ (บาท),ปริมาณที่ซื้อ,หน่วย,Yield (%),ต้นทุนสุทธิ EP (บาท/หน่วย)\n";
          ingredients.value.forEach(i => {
            csv += `"${i.name}","${i.category}",${i.purchasePrice},${i.purchaseQty},"${i.unit}",${i.yieldPercent},${getEpUnitCost(i).toFixed(2)}\n`;
          });

          csv += "\n--- สรุปต้นทุนและราคาขายเมนู (RECIPES SUMMARY) ---\n";
          csv += "ชื่อเมนู,จำนวนเสิร์ฟ,ต้นทุนรวม (บาท),ต้นทุนต่อจาน (บาท),ราคาขายหน้าร้าน (บาท),Food Cost (%),กำไรต่อจาน (บาท)\n";
          recipes.value.forEach(r => {
            csv += `"${r.name}",${r.portion},${getRecipeTotalCost(r).toFixed(2)},${getRecipePortionCost(r).toFixed(2)},${r.sellingPrice},${getActualFoodCostPercent(r).toFixed(2)},${getProfitPerPortion(r).toFixed(2)}\n`;
          });

          const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.setAttribute("href", url);
          link.setAttribute("download", `Recipe_Costing_${new Date().toISOString().slice(0,10)}.csv`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        };

        onMounted(() => {
          loadSavedData();
        });

        return {
          activeTab,
          ingredients,
          recipes,
          saveData,
          resetToDefaultData,
          addIngredient,
          deleteIngredient,
          addRecipe,
          deleteRecipe,
          addRecipeItem,
          removeRecipeItem,
          getEpUnitCost,
          getItemUnit,
          getItemCost,
          getRecipeTotalCost,
          getRecipePortionCost,
          getRecommendedPrice,
          getActualFoodCostPercent,
          getProfitPerPortion,
          getAverageFoodCost,
          getAverageMargin,
          exportToExcel
        };
      }
    }).mount('#app');
  </script>
</body>
</html>
